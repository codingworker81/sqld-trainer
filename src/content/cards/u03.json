[
  { "id": "u03-char-001", "unitId": "u03", "type": "definition", "front": "LOWER / UPPER / INITCAP 함수의 역할은?", "back": "LOWER는 소문자로, UPPER는 대문자로 바꾸고, INITCAP은 각 단어의 첫 글자만 대문자로 바꾼다.", "tags": [], "verified": false },
  { "id": "u03-char-002", "unitId": "u03", "type": "choice", "front": "SELECT INITCAP('seoul city') FROM DUAL; 의 결과는?", "choices": ["Seoul city", "Seoul City", "SEOUL CITY", "seoul City"], "answer": "2", "explanation": "INITCAP은 공백으로 구분된 각 단어의 첫 글자만 대문자로 바꾼다.", "tags": [], "verified": false },
  { "id": "u03-char-003", "unitId": "u03", "type": "predict", "front": "SELECT SUBSTR('ABCDEF', 2, 3) FROM DUAL;", "back": "'BCD'", "explanation": "2번째 글자부터 3글자를 가져온다.", "tags": ["oracle"], "verified": false },
  { "id": "u03-char-004", "unitId": "u03", "type": "predict", "front": "SELECT SUBSTR('ABCDEF', -3, 2) FROM DUAL;", "back": "'DE'", "explanation": "시작 위치가 음수이면 문자열 뒤에서부터 센다. 뒤에서 3번째 'D'부터 2글자.", "tags": ["oracle", "trap"], "verified": false },
  { "id": "u03-char-005", "unitId": "u03", "type": "ox", "front": "SUBSTR('ABCDEF', -2)는 'EF'를 반환한다.", "answer": "O", "explanation": "길이를 생략하면 시작 위치부터 끝까지 반환하고, 음수 시작 위치는 뒤에서부터 센다.", "tags": ["oracle", "trap"], "verified": false },
  { "id": "u03-char-006", "unitId": "u03", "type": "cloze", "front": "___는 문자 수를, LENGTHB는 바이트 수를 반환하며 한글 같은 멀티바이트 문자에서 두 결과가 다르다.", "back": "LENGTH", "tags": [], "verified": false },
  { "id": "u03-char-007", "unitId": "u03", "type": "predict", "front": "SELECT INSTR('ABCABC', 'B', 1, 2) FROM DUAL;", "back": "5", "explanation": "1번째 위치부터 찾을 때 'B'가 두 번째로 나오는 위치.", "tags": ["oracle"], "verified": false },
  { "id": "u03-char-008", "unitId": "u03", "type": "cloze", "front": "INSTR(str, substr, start, occurrence)는 start 위치부터 substr이 occurrence번째로 나타나는 ___를 반환한다.", "back": "위치", "tags": [], "verified": false },
  { "id": "u03-char-009", "unitId": "u03", "type": "predict", "front": "SELECT LPAD('5', 3, '0') FROM DUAL;", "back": "'005'", "explanation": "왼쪽을 '0'으로 채워 전체 길이 3을 맞춘다.", "tags": ["oracle"], "verified": false },
  { "id": "u03-char-010", "unitId": "u03", "type": "ox", "front": "RPAD('5', 3, '0')의 결과는 '005'이다.", "answer": "X", "explanation": "RPAD는 오른쪽에 채우므로 결과는 '500'이다.", "tags": ["oracle"], "verified": false },
  { "id": "u03-char-011", "unitId": "u03", "type": "predict", "front": "SELECT TRIM('  ab  ') FROM DUAL;", "back": "'ab'", "explanation": "양쪽 공백을 제거한다.", "tags": ["oracle"], "verified": false },
  { "id": "u03-char-012", "unitId": "u03", "type": "choice", "front": "다음 중 문자열 양쪽 공백만 제거하는 함수는?", "choices": ["LTRIM", "RTRIM", "TRIM", "REPLACE"], "answer": "3", "tags": [], "verified": false },
  { "id": "u03-char-013", "unitId": "u03", "type": "predict", "front": "SELECT REPLACE('ABCA', 'A', 'X') FROM DUAL;", "back": "'XBCX'", "explanation": "문자열에 나오는 모든 'A'를 'X'로 바꾼다.", "tags": ["oracle"], "verified": false },
  { "id": "u03-char-014", "unitId": "u03", "type": "ox", "front": "CONCAT 함수는 3개 이상의 문자열을 한 번에 연결할 수 있다.", "answer": "X", "explanation": "CONCAT은 인자를 2개까지만 받는다. 3개 이상은 ||를 쓰거나 CONCAT을 중첩해야 한다.", "tags": ["oracle", "trap"], "verified": false },

  { "id": "u03-num-001", "unitId": "u03", "type": "definition", "front": "ROUND와 TRUNC의 차이는?", "back": "ROUND는 지정한 자리에서 반올림(0.5는 올림)하고, TRUNC는 반올림 없이 그 자리에서 버린다.", "tags": [], "verified": false },
  { "id": "u03-num-002", "unitId": "u03", "type": "choice", "front": "SELECT ROUND(123.456, 1) FROM DUAL; 의 결과는?", "choices": ["123.4", "123.5", "123.45", "124"], "answer": "2", "tags": [], "verified": false },
  { "id": "u03-num-003", "unitId": "u03", "type": "predict", "front": "SELECT TRUNC(123.456, 1) FROM DUAL;", "back": "123.4", "explanation": "반올림 없이 소수 첫째 자리까지만 남기고 버린다.", "tags": ["oracle"], "verified": false },
  { "id": "u03-num-004", "unitId": "u03", "type": "predict", "front": "SELECT ROUND(1250, -2) FROM DUAL;", "back": "1300", "explanation": "음수 자릿수는 정수부에서 반올림한다. 백의 자리에서 반올림하면 1300.", "tags": ["oracle", "trap"], "verified": false },
  { "id": "u03-num-005", "unitId": "u03", "type": "predict", "front": "SELECT TRUNC(1250, -2) FROM DUAL;", "back": "1200", "explanation": "음수 자릿수는 정수부에서 버림한다. 백의 자리 밑을 버리면 1200.", "tags": ["oracle", "trap"], "verified": false },
  { "id": "u03-num-006", "unitId": "u03", "type": "ox", "front": "ROUND(n, d)에서 d가 음수이면 소수점 자리에서 반올림한다.", "answer": "X", "explanation": "d가 음수면 소수점이 아니라 정수부(십의 자리, 백의 자리 등)에서 반올림한다.", "tags": ["oracle", "trap"], "verified": false },
  { "id": "u03-num-007", "unitId": "u03", "type": "predict", "front": "SELECT MOD(10, 3) FROM DUAL;", "back": "1", "tags": ["oracle"], "verified": false },
  { "id": "u03-num-008", "unitId": "u03", "type": "predict", "front": "SELECT MOD(15, 4) FROM DUAL;", "back": "3", "tags": ["oracle"], "verified": false },
  { "id": "u03-num-009", "unitId": "u03", "type": "ox", "front": "CEIL(4.1)의 결과는 4이다.", "answer": "X", "explanation": "CEIL은 올림이므로 결과는 5이다.", "tags": ["oracle"], "verified": false },
  { "id": "u03-num-010", "unitId": "u03", "type": "predict", "front": "SELECT FLOOR(4.9) FROM DUAL;", "back": "4", "explanation": "FLOOR는 내림이므로 소수부를 버린 정수를 반환한다.", "tags": ["oracle"], "verified": false },
  { "id": "u03-num-011", "unitId": "u03", "type": "predict", "front": "SELECT POWER(2, 3) FROM DUAL;", "back": "8", "tags": ["oracle"], "verified": false },
  { "id": "u03-num-012", "unitId": "u03", "type": "choice", "front": "SIGN(-5)의 결과는?", "choices": ["-5", "-1", "0", "1"], "answer": "2", "tags": [], "verified": false },

  { "id": "u03-date-001", "unitId": "u03", "type": "definition", "front": "SYSDATE는 무엇을 반환하는가?", "back": "현재 날짜와 시각을 반환한다.", "tags": [], "verified": false },
  { "id": "u03-date-002", "unitId": "u03", "type": "definition", "front": "ADD_MONTHS(d, n)은 무엇을 하는가?", "back": "날짜 d에서 n개월 후의 날짜를 반환한다(n이 음수면 그만큼 이전 날짜).", "tags": [], "verified": false },
  { "id": "u03-date-003", "unitId": "u03", "type": "cloze", "front": "___ 함수는 두 날짜 사이의 개월 수를 소수로 반환한다.", "back": "MONTHS_BETWEEN", "tags": [], "verified": false },
  { "id": "u03-date-004", "unitId": "u03", "type": "definition", "front": "NEXT_DAY(d, '요일')은 무엇을 반환하는가?", "back": "d 이후 가장 가까운 지정 요일의 날짜를 반환한다.", "tags": [], "verified": false },
  { "id": "u03-date-005", "unitId": "u03", "type": "cloze", "front": "___ 함수는 해당 월의 마지막 날짜를 반환한다.", "back": "LAST_DAY", "tags": [], "verified": false },
  { "id": "u03-date-006", "unitId": "u03", "type": "definition", "front": "EXTRACT(YEAR/MONTH/DAY FROM d)는 무엇을 하는가?", "back": "날짜 d에서 연/월/일 등 구성 요소만 추출한다.", "tags": [], "verified": false },
  { "id": "u03-date-007", "unitId": "u03", "type": "cloze", "front": "날짜 + 숫자는 숫자만큼 더해진 ___를 반환한다.", "back": "날짜", "tags": [], "verified": false },
  { "id": "u03-date-008", "unitId": "u03", "type": "cloze", "front": "날짜 - 날짜는 두 날짜 사이의 ___를 반환한다.", "back": "일수(숫자)", "tags": [], "verified": false },
  { "id": "u03-date-009", "unitId": "u03", "type": "ox", "front": "날짜끼리 더하는 것(날짜 + 날짜)은 가능하다.", "answer": "X", "explanation": "날짜+숫자, 날짜-날짜는 가능하지만 날짜+날짜는 에러가 난다.", "tags": ["oracle", "trap"], "verified": false },
  { "id": "u03-date-010", "unitId": "u03", "type": "predict", "front": "SELECT LAST_DAY(DATE '2026-02-15') FROM DUAL;", "back": "2026-02-28", "explanation": "2026년은 평년이라 2월은 28일까지다.", "tags": ["oracle"], "verified": false },

  { "id": "u03-conv-001", "unitId": "u03", "type": "definition", "front": "TO_CHAR(값, [포맷])은 무엇을 하는가?", "back": "숫자나 날짜를 지정한 포맷의 문자열로 변환한다.", "tags": [], "verified": false },
  { "id": "u03-conv-002", "unitId": "u03", "type": "definition", "front": "TO_DATE(문자, [포맷])는 무엇을 하는가?", "back": "문자열을 지정한 포맷으로 해석해 날짜로 변환한다.", "tags": [], "verified": false },
  { "id": "u03-conv-003", "unitId": "u03", "type": "definition", "front": "TO_NUMBER(문자, [포맷])는 무엇을 하는가?", "back": "문자열을 숫자로 변환한다.", "tags": [], "verified": false },
  { "id": "u03-conv-004", "unitId": "u03", "type": "predict", "front": "SELECT TO_CHAR(1234567, 'FM999,999,999') FROM DUAL;", "back": "'1,234,567'", "explanation": "FM은 불필요한 공백을 없애고, 콤마는 천 단위 구분자로 들어간다.", "tags": ["oracle"], "verified": false },
  { "id": "u03-conv-005", "unitId": "u03", "type": "ox", "front": "TO_CHAR(DATE '2026-11-14', 'YYYY\"년\" MM\"월\"')의 결과는 '2026년 11월'이다.", "answer": "O", "explanation": "큰따옴표로 감싼 문자는 포맷 모델에서 그대로 출력된다.", "tags": ["oracle"], "verified": false },
  { "id": "u03-conv-006", "unitId": "u03", "type": "predict", "front": "SELECT TO_CHAR(DATE '2026-11-14', 'YYYY-MM-DD') FROM DUAL;", "back": "'2026-11-14'", "tags": ["oracle"], "verified": false },
  { "id": "u03-conv-007", "unitId": "u03", "type": "ox", "front": "WHERE절에서 문자형 컬럼과 숫자를 비교하면 Oracle이 자동으로 형변환해 항상 안전하게 동작한다.", "answer": "X", "explanation": "암시적 형변환은 되지만 인덱스를 못 쓰거나 의도와 다른 비교가 될 수 있어 명시적 변환이 더 안전하다.", "tags": ["trap"], "verified": false },
  { "id": "u03-conv-008", "unitId": "u03", "type": "definition", "front": "암시적 형변환(implicit conversion)이란?", "back": "Oracle이 비교·연산 시 타입을 자동으로 맞춰주는 것. 편리하지만 부작용이 있을 수 있어 명시적 변환이 권장된다.", "tags": [], "verified": false },

  { "id": "u03-null-001", "unitId": "u03", "type": "definition", "front": "NVL(expr1, expr2)의 동작은?", "back": "expr1이 NULL이면 expr2를, 아니면 expr1을 반환한다.", "tags": [], "verified": false },
  { "id": "u03-null-002", "unitId": "u03", "type": "definition", "front": "NVL2(expr1, expr2, expr3)의 동작은?", "back": "expr1이 NULL이 아니면 expr2를, NULL이면 expr3을 반환한다.", "tags": [], "verified": false },
  { "id": "u03-null-003", "unitId": "u03", "type": "definition", "front": "NULLIF(expr1, expr2)의 동작은?", "back": "expr1과 expr2가 같으면 NULL을, 다르면 expr1을 반환한다.", "tags": [], "verified": false },
  { "id": "u03-null-004", "unitId": "u03", "type": "predict", "front": "SELECT NULLIF('A', 'A') FROM DUAL;", "back": "NULL", "explanation": "두 값이 같으므로 NULL을 반환한다.", "tags": ["oracle", "trap"], "verified": false },
  { "id": "u03-null-005", "unitId": "u03", "type": "predict", "front": "SELECT NULLIF('A', 'B') FROM DUAL;", "back": "'A'", "explanation": "두 값이 다르므로 첫 번째 값을 그대로 반환한다.", "tags": ["oracle"], "verified": false },
  { "id": "u03-null-006", "unitId": "u03", "type": "cloze", "front": "___ 함수는 인자 중 첫 번째 NULL이 아닌 값을 반환하며, NVL과 달리 인자를 3개 이상 받을 수 있다.", "back": "COALESCE", "tags": [], "verified": false },
  { "id": "u03-null-007", "unitId": "u03", "type": "predict", "front": "SELECT NVL(NULL, 'X') FROM DUAL;", "back": "'X'", "tags": ["oracle"], "verified": false },
  { "id": "u03-null-008", "unitId": "u03", "type": "predict", "front": "SELECT NVL2(NULL, 'A', 'B') FROM DUAL;", "back": "'B'", "tags": ["oracle"], "verified": false },
  { "id": "u03-null-009", "unitId": "u03", "type": "predict", "front": "SELECT NVL2('val', 'A', 'B') FROM DUAL;", "back": "'A'", "tags": ["oracle"], "verified": false },
  { "id": "u03-null-010", "unitId": "u03", "type": "predict", "front": "SELECT COALESCE(NULL, NULL, 'Z', 'Y') FROM DUAL;", "back": "'Z'", "tags": ["oracle"], "verified": false },
  { "id": "u03-null-011", "unitId": "u03", "type": "choice", "front": "다음 중 인자를 3개 이상 받을 수 있는 NULL 처리 함수는?", "choices": ["NVL", "NVL2", "NULLIF", "COALESCE"], "answer": "4", "tags": [], "verified": false },
  { "id": "u03-null-012", "unitId": "u03", "type": "ox", "front": "NULLIF(5, 5)의 결과는 5이다.", "answer": "X", "explanation": "두 값이 같으면 NULL을 반환한다.", "tags": ["oracle", "trap"], "verified": false },

  { "id": "u03-case-001", "unitId": "u03", "type": "definition", "front": "DECODE(expr, val1, res1, val2, res2, ..., default)의 동작은?", "back": "expr이 val1과 같으면 res1, val2와 같으면 res2, ... 아무것도 안 맞으면 default를 반환한다.", "tags": [], "verified": false },
  { "id": "u03-case-002", "unitId": "u03", "type": "definition", "front": "CASE WHEN ... THEN ... ELSE ... END의 특징은?", "back": "비교·범위 등 조건식을 자유롭게 써서 분기할 수 있는 표준 SQL 문법이다.", "tags": [], "verified": false },
  { "id": "u03-case-003", "unitId": "u03", "type": "ox", "front": "DECODE는 두 NULL을 같다고 취급해 매칭시킨다.", "answer": "O", "explanation": "DECODE는 NULL과 NULL을 같다고 보는 유일한 비교 함수다.", "tags": ["oracle", "trap"], "verified": false },
  { "id": "u03-case-004", "unitId": "u03", "type": "ox", "front": "CASE WHEN col = NULL THEN ... 은 col이 NULL인 행을 찾아낸다.", "answer": "X", "explanation": "표준 비교에서 NULL=NULL은 항상 UNKNOWN(거짓)이다. NULL 확인은 IS NULL을 써야 한다.", "tags": ["trap"], "verified": false },
  { "id": "u03-case-005", "unitId": "u03", "type": "predict", "front": "SELECT DECODE(NULL, NULL, '일치', '불일치') FROM DUAL;", "back": "'일치'", "explanation": "DECODE는 NULL과 NULL을 같다고 취급해 매칭시킨다.", "tags": ["oracle", "trap"], "verified": false },
  { "id": "u03-case-006", "unitId": "u03", "type": "definition", "front": "CASE와 DECODE의 적용 범위 차이는?", "back": "DECODE는 값이 완전히 같을 때만 매칭되어 범위 비교가 안 되지만, CASE는 비교·범위 조건을 자유롭게 쓸 수 있다.", "tags": [], "verified": false },
  { "id": "u03-case-007", "unitId": "u03", "type": "predict", "front": "SELECT CASE WHEN 85 >= 90 THEN 'A' WHEN 85 >= 80 THEN 'B' ELSE 'C' END FROM DUAL;", "back": "'B'", "tags": ["oracle"], "verified": false },
  { "id": "u03-case-008", "unitId": "u03", "type": "dbms", "front": "Oracle의 DECODE 함수는 SQL Server에서 어떻게 대체하는가?", "back": "SQL Server에는 DECODE가 없어 CASE 표현식으로 대체한다.", "tags": ["mssql"], "verified": false },

  { "id": "u03-dbms-001", "unitId": "u03", "type": "dbms", "front": "Oracle의 SUBSTR 함수는 SQL Server에서 어떤 함수에 대응하는가?", "back": "SUBSTRING", "tags": ["mssql"], "verified": false },
  { "id": "u03-dbms-002", "unitId": "u03", "type": "dbms", "front": "Oracle의 NVL(expr1, expr2)은 SQL Server에서 어떤 함수에 대응하는가?", "back": "ISNULL(expr1, expr2)", "tags": ["mssql"], "verified": false },
  { "id": "u03-dbms-003", "unitId": "u03", "type": "dbms", "front": "Oracle의 SYSDATE는 SQL Server에서 어떤 함수에 대응하는가?", "back": "GETDATE()", "tags": ["mssql"], "verified": false },
  { "id": "u03-dbms-004", "unitId": "u03", "type": "ox", "front": "Oracle의 CONCAT은 SQL Server의 CONCAT과 달리 인자를 2개까지만 받는다.", "answer": "O", "explanation": "SQL Server의 CONCAT은 인자를 여러 개 받을 수 있지만 Oracle은 2개로 제한된다.", "tags": ["mssql", "trap"], "verified": false },
  { "id": "u03-dbms-005", "unitId": "u03", "type": "dbms", "front": "Oracle에서 나머지를 구하는 MOD(n,m) 함수는 SQL Server에서 어떤 연산자로 대체되는가?", "back": "% 연산자(n % m)", "tags": ["mssql"], "verified": false },
  { "id": "u03-dbms-006", "unitId": "u03", "type": "dbms", "front": "Oracle의 LENGTH 함수는 SQL Server에서 어떤 함수에 대응하는가?", "back": "LEN", "tags": ["mssql"], "verified": false }
]
